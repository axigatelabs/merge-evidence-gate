{
  "name": "merge-evidence-gate",
  "version": "0.5.1",
  "private": true,
  "description": "Re-runs AI-agent pull requests in a clean environment, compares what the agent claimed to what actually happened, and posts a signed receipt that decides merge eligibility.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:action && npm run build:cli",
    "build:action": "ncc build src/main.ts -o dist --license licenses.txt",
    "build:cli": "ncc build src/cli.ts -o dist/cli --license licenses.txt",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@actions/artifact": "^2.3.2",
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.1",
    "@actions/glob": "^0.5.0",
    "fast-xml-parser": "^5.2.5",
    "minimatch": "^10.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
